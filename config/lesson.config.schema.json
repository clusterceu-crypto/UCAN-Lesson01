{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucan.example/schemas/lesson.config.schema.v1.json",
  "title": "UCAN Lesson Configuration",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "runtimeVersion",
    "configVersion",
    "stateSchemaVersion",
    "lessonId",
    "lessonVersion",
    "title",
    "pageCount",
    "initialPage",
    "pageOrder",
    "pageLabels",
    "routes",
    "storageNamespace",
    "features",
    "gates",
    "assessments",
    "portfolio",
    "ai",
    "externalLinks",
    "nextLesson"
  ],
  "properties": {
    "runtimeVersion": {"const": "1.0.0"},
    "configVersion": {"type": "string"},
    "stateSchemaVersion": {"type": "string"},
    "lessonId": {"type": "string", "minLength": 1},
    "lessonVersion": {"type": "string"},
    "title": {"type": "string"},
    "pageCount": {"type": "integer", "minimum": 1},
    "initialPage": {"type": "string"},
    "pageOrder": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "pageLabels": {"type": "object"},
    "routes": {"type": "object"},
    "storageNamespace": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "features": {"type": "object"},
    "gates": {"type": "array", "items": {"type": "object", "required": ["id", "page", "controlsPage", "type", "approvedTransition", "incorrectTransition", "invalidation"], "properties": {"id": {"type": "string"}, "page": {"type": "string"}, "controlsPage": {"type": "string"}, "approvedTransition": {"type": "object", "required": ["answerId"]}}}},
    "assessments": {"type": "array"},
    "portfolio": {"type": "object", "required": ["fields"], "properties": {"fields": {"type": "array"}}},
    "ai": {"type": "object"},
    "externalLinks": {"type": "array"},
    "nextLesson": {"type": ["object", "null"]}
  }
}
